<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings and every game reference live in the repo-root Directory.Build.props.
       This file only names the plugin. -->
  <PropertyGroup>
    <AssemblyName>CombatText</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- UnityEngine.IMGUIModule provides GUI, GUIStyle and Event for the overlay;
       UnityEngine.TextRenderingModule provides the FontStyle and TextAnchor the number style sets;
       UnityEngine.UIModule provides Canvas, read for the game's HUD scale factor. -->
  <ItemGroup>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(BepInExInterop)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(BepInExInterop)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(BepInExInterop)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
